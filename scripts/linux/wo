def run_mail_download(args: argparse.Namespace) -> int:
    run_id = args.run_id or next_run_id("wo-mail-download")
    message_ids = [value for value in (args.message_id or []) if value.strip()]
    has_subject = bool(args.subject and args.subject.strip())
    has_message_ids = bool(message_ids)
    if not has_subject and not has_message_ids:
        return usage_summary(
            args=args,
            run_id=run_id,
            command="wo mail download",
            response_name="mail-download.json",
            status="usage_error",
            error_code="mail_download_scope_required",
            message="mail download requires --subject or --message-id to avoid broad downloads",
            inputs={
                "baseUrl": args.base_url,
                "exchangeRoot": str(args.exchange_root),
                "runId": run_id,
                "folder": args.folder,
                "freshness": args.freshness,
                "dryRun": args.dry_run,
            },
        )
    payload: dict[str, Any] = {
        "runId": run_id,
        "freshness": args.freshness,
        "dryRun": args.dry_run,
    }
    if args.folder:
        payload["folderPath"] = args.folder
    if has_subject:
        payload["subjectContains"] = args.subject
    if has_message_ids:
        payload["messageIds"] = message_ids
    return run_rest_command(
        args=args,
        method="POST",
        path="/v1/mail/attachments/download",
        payload=payload,
        command="wo mail download",
        response_name="mail-download.json",
        run_id_prefix="wo-mail-download",
        success_when=endpoint_success,
        success_status="ok",
        failure_status="mail-download-failed",
        gate_name="mail-download",
        stage="mail-download",
        detail_prefix="POST /v1/mail/attachments/download",
        extra_builder=summarize_mail_download,
        effective_run_id=run_id,
    )


