def repo_root() -> Path:
    return Path(__file__).resolve().parents[2]


def resolve_repo_path(path: Path) -> Path:
    if path.is_absolute():
        return path
    return repo_root() / path


def rest_retryable(status: int | str) -> bool:
    return status == "exception" or (isinstance(status, int) and status >= 500)


def endpoint_success(status: int | str, parsed: Any) -> bool:
    return status == 200 and isinstance(parsed, dict) and parsed.get("success") is True


def usage_summary(
    *,
    args: argparse.Namespace,
    run_id: str,
    command: str,
    response_name: str,
    status: str,
    error_code: str,
    message: str,
    inputs: dict[str, Any],
) -> int:
    started_at_utc = utc_now()
    response_path = args.exchange_root / "runs" / run_id / response_name
    payload = {"code": error_code, "message": message}
    write_json(response_path, payload)
    summary_path = args.exchange_root / "runs" / run_id / "summary.json"
    summary = {
        "success": False,
        "status": status,
        "command": command,
        "runId": run_id,
        "baseUrl": args.base_url,
        "exchangeRoot": str(args.exchange_root),
        "summaryPath": str(summary_path),
        "startedAtUtc": started_at_utc,
        "observedAtUtc": started_at_utc,
        "elapsedSeconds": 0,
        "inputs": inputs,
        "artifacts": {
            "responsePath": str(response_path),
        },
        "gates": [
            {
                "name": "local-input-gate",
                "status": "failed",
                "required": True,
                "observedAtUtc": started_at_utc,
                "detail": message,
                "evidencePath": str(response_path),
            }
        ],
        "error": {
            "code": error_code,
            "message": message,
            "retryable": False,
            "stage": "argument-validation",
            "details": None,
        },
        "cleanup": None,
        "httpStatus": "local",
    }
    write_json(summary_path, summary)
    if args.json:
        print(json.dumps({"summaryPath": str(summary_path)}))
    else:
        print(summary_path)
    return 2


def run_rest_command(
    *,
    args: argparse.Namespace,
    method: str,
    path: str,
    payload: dict[str, Any] | None,
    command: str,
    response_name: str,
    run_id_prefix: str,
    success_when,
    success_status: str = "ok",
    failure_status: str = "request-failed",
    gate_name: str,
    stage: str,
    detail_prefix: str,
    extra_builder=None,
    effective_run_id: str | None = None,
) -> int:
    started = time.time()
    started_at_utc = utc_now()
    run_id = effective_run_id or args.run_id or next_run_id(run_id_prefix)
    status, body, parsed = request_json(args.base_url, method, path, payload)
    response_payload = parsed if parsed is not None else {"raw": body.decode("utf-8", "replace")}
    success = success_when(status, parsed)
    response_path = args.exchange_root / "runs" / run_id / response_name
    gate = {
        "name": gate_name,
        "status": "passed" if success else "failed",
        "required": True,
        "observedAtUtc": utc_now(),
        "detail": f"{detail_prefix} returned HTTP {status}",
        "evidencePath": str(response_path),
    }
    error = None
    if not success:
        error = {
            "code": "rest_request_failed",
            "message": f"{detail_prefix} returned {status}",
            "retryable": rest_retryable(status),
            "stage": stage,
            "details": {
                "httpStatus": status,
            },
        }
    extra = extra_builder(parsed, run_id) if callable(extra_builder) else None
    return emit_contract_summary(
        exchange_root=args.exchange_root,
        run_id=run_id,
        command=command,
        base_url=args.base_url,
        response_name=response_name,
        response_payload=response_payload,
        success=success,
        status=success_status if success else failure_status,
        http_status=status,
        started_at_utc=started_at_utc,
        elapsed_seconds=time.time() - started,
        inputs={
            "baseUrl": args.base_url,
            "exchangeRoot": str(args.exchange_root),
            "runId": run_id,
            **({"request": payload} if payload is not None else {}),
        },
        gates=[gate],
        error=error,
        cleanup=None,
        extra=extra,
        json_stdout=args.json,
    )


