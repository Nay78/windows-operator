def summarize_windows(parsed: Any) -> dict[str, Any]:
    windows = parsed if isinstance(parsed, list) else []
    top_titles: list[str] = []
    for item in windows[:5]:
        if not isinstance(item, dict):
            continue
        title = str(item.get("title", "")).strip()
        if title:
            top_titles.append(title)
    return {
        "windowCount": len(windows),
        "sampleTitles": top_titles,
    }


