def summarize_mail_download(parsed: Any, run_id: str) -> dict[str, Any]:
    extra: dict[str, Any] = {}
    if not isinstance(parsed, dict):
        return extra
    attachments_saved = parsed.get("attachmentsSaved")
    attachments_skipped = parsed.get("attachmentsSkipped")
    saved = parsed.get("saved")
    skipped = parsed.get("skipped")
    if isinstance(attachments_saved, int):
        extra["attachmentsSaved"] = attachments_saved
    if isinstance(attachments_skipped, int):
        extra["attachmentsSkipped"] = attachments_skipped
    if isinstance(saved, list):
        extra["savedCount"] = len(saved)
    if isinstance(skipped, list):
        extra["skippedCount"] = len(skipped)
    result_run_id = parsed.get("runId")
    if isinstance(result_run_id, str) and result_run_id:
        extra["mailRunId"] = result_run_id
    else:
        extra["mailRunId"] = run_id
    return extra


