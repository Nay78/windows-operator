{
  "Urls": "https://0.0.0.0:443",
  "Relay": {
    "UpstreamBaseUrl": "http://127.0.0.1:43117",
    "PublicBaseUrl": "https://operator-relay.example",
    "Callers": [
      {
        "Id": "example-consumer",
        "TokenSha256": "<replace-with-64-hex-character-sha256>",
        "Routes": [
          {
            "Method": "GET",
            "RouteTemplate": "/v1/health",
            "RequestsPerMinute": 60
          },
          {
            "Method": "GET",
            "RouteTemplate": "/v1/capabilities",
            "RequestsPerMinute": 30
          },
          {
            "Method": "GET",
            "RouteTemplate": "/v1/artifacts/{artifactId}",
            "RequestsPerMinute": 120
          },
          {
            "Method": "GET",
            "RouteTemplate": "/v1/runs/{runId}/artifacts",
            "RequestsPerMinute": 120
          },
          {
            "Method": "POST",
            "RouteTemplate": "/v1/powerpoint/online/updates",
            "RequestsPerMinute": 6
          },
          {
            "Method": "POST",
            "RouteTemplate": "/v1/mail/folders",
            "RequestsPerMinute": 12
          },
          {
            "Method": "GET",
            "RouteTemplate": "/v1/mail/status",
            "RequestsPerMinute": 30
          },
          {
            "Method": "POST",
            "RouteTemplate": "/v1/mail/messages/search",
            "RequestsPerMinute": 12
          },
          {
            "Method": "POST",
            "RouteTemplate": "/v1/mail/attachments/download",
            "RequestsPerMinute": 12
          },
          {
            "Method": "GET",
            "RouteTemplate": "/v1/mail/runs/{runId}",
            "RequestsPerMinute": 30
          }
        ]
      }
    ]
  }
